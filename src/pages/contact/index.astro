---
import BaseLayout from '../../layouts/BaseLayout.astro';

const SITE = 'https://interpreting.works';

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "@id": `${SITE}/contact/#contactpage`,
    name: "Contact interpretingWorks",
    url: `${SITE}/contact/`,
    description: "Contact interpretingWorks for professional interpreter scheduling inquiries. Reach our team by phone, email, or the contact form.",
    isPartOf: { "@type": "WebSite", "@id": `${SITE}/#website` },
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": `${SITE}/#localbusiness`,
    name: "interpretingWorks — Language Link Corporation",
    telephone: "+18009050896",
    email: "sales@interpreting.works",
    address: {
      "@type": "PostalAddress",
      streetAddress: "420 East Main St. Suite 7",
      addressLocality: "Branford",
      addressRegion: "CT",
      postalCode: "06405",
      addressCountry: "US",
    },
    areaServed: { "@type": "Country", name: "United States" },
    url: `${SITE}/`,
  },
];

const CONTACT_CARDS = [
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25z"/></svg>`,
    label: 'Call Us',
    value: '800-905-0896',
    href: 'tel:+18009050896',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>`,
    label: 'Email Us',
    value: 'sales@interpreting.works',
    href: 'mailto:sales@interpreting.works',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/><path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0z"/></svg>`,
    label: 'Our Office',
    value: '420 East Main St. Suite 7\nBranford, CT 06405',
    href: 'https://maps.google.com/?q=420+East+Main+St+Suite+7+Branford+CT+06405',
  },
];
---

<BaseLayout
  title="Contact Us — interpretingWorks"
  description="Contact interpretingWorks — call, email, or send a message about professional interpreter scheduling for hospitals, courts, and businesses across the US."
  geoRegion="US-CT"
  geoPlacename="Branford, Connecticut"
  geoPosition="41.2793;-72.8162"
  schema={pageSchema}
>

  <main>

    <!-- HERO STRIP -->
    <section class="bg-[#0D1B2A] text-white pt-16 pb-0 overflow-hidden">
      <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-10 items-end">

          <!-- Left: headline + contact cards -->
          <div class="pb-16">
            <div class="mb-5 inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-semibold text-white/80">
              We'd love to hear from you
            </div>
            <h1 class="text-[42px] sm:text-[56px] font-extrabold leading-[1.02] tracking-[-0.04em] mb-6">
              Contact Us
            </h1>
            <p class="text-white/70 text-lg leading-relaxed mb-10 max-w-md">
              Whether you're an organization looking for interpreter services or a language service provider exploring Access Point — our team is ready to help.
            </p>

            <!-- Contact cards -->
            <div class="flex flex-col gap-3">
              {CONTACT_CARDS.map(card => (
                <a
                  href={card.href}
                  target={card.href.startsWith('http') ? '_blank' : undefined}
                  rel={card.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="group flex items-start gap-4 rounded-2xl bg-white/[0.07] hover:bg-white/[0.13] border border-white/10 px-5 py-4 transition-all duration-200"
                >
                  <span class="mt-0.5 flex-shrink-0 w-9 h-9 rounded-xl bg-[#DC3C52]/20 text-[#DC3C52] flex items-center justify-center group-hover:bg-[#DC3C52] group-hover:text-white transition-colors" set:html={card.icon} />
                  <div>
                    <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-0.5">{card.label}</p>
                    <p class="text-white font-semibold text-sm whitespace-pre-line leading-snug">{card.value}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- Right: team photo cropped into the hero -->
          <div class="hidden lg:block self-end">
            <img
              src="/img/team-founding-leadership.png"
              alt="interpretingWorks founding leadership team"
              class="w-full max-w-lg ml-auto rounded-t-3xl object-cover object-top"
              style="max-height: 420px; object-position: center top;"
              width="600" height="420"
              loading="eager"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- FORM + SIDE INFO -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-start">

          <!-- Form -->
          <div class="bg-white rounded-3xl p-8 md:p-10 shadow-xl shadow-slate-900/8 border border-gray-100">
            <h2 class="text-2xl font-bold text-[#0D1B2A] mb-2">Send Us a Message</h2>
            <p class="text-gray-500 text-sm mb-8">We'll get back to you within one business day.</p>

            <form
              name="contact"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="space-y-5"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

              <div class="grid sm:grid-cols-2 gap-4">
                <div>
                  <label for="first-name" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">First Name <span class="text-[#DC3C52]">*</span></label>
                  <input
                    id="first-name"
                    name="first-name"
                    type="text"
                    required
                    autocomplete="given-name"
                    class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-[#0D1B2A] placeholder-gray-300 focus:border-[#DC3C52] focus:ring-2 focus:ring-[#DC3C52]/20 outline-none transition-all"
                    placeholder="Jane"
                  />
                </div>
                <div>
                  <label for="last-name" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Last Name <span class="text-[#DC3C52]">*</span></label>
                  <input
                    id="last-name"
                    name="last-name"
                    type="text"
                    required
                    autocomplete="family-name"
                    class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-[#0D1B2A] placeholder-gray-300 focus:border-[#DC3C52] focus:ring-2 focus:ring-[#DC3C52]/20 outline-none transition-all"
                    placeholder="Doe"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Email <span class="text-[#DC3C52]">*</span></label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-[#0D1B2A] placeholder-gray-300 focus:border-[#DC3C52] focus:ring-2 focus:ring-[#DC3C52]/20 outline-none transition-all"
                  placeholder="jane@yourorganization.com"
                />
              </div>

              <div>
                <label for="organization" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Organization</label>
                <input
                  id="organization"
                  name="organization"
                  type="text"
                  autocomplete="organization"
                  class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-[#0D1B2A] placeholder-gray-300 focus:border-[#DC3C52] focus:ring-2 focus:ring-[#DC3C52]/20 outline-none transition-all"
                  placeholder="Hospital, court, agency..."
                />
              </div>

              <div>
                <label for="message" class="block text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Message <span class="text-[#DC3C52]">*</span></label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-[#0D1B2A] placeholder-gray-300 focus:border-[#DC3C52] focus:ring-2 focus:ring-[#DC3C52]/20 outline-none transition-all resize-none"
                  placeholder="Tell us how we can help you..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full rounded-full bg-[#DC3C52] px-8 py-4 text-base font-semibold text-white hover:bg-[#b83044] transition-colors shadow-lg shadow-[#DC3C52]/20 flex items-center justify-center gap-2"
              >
                Send Message
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </button>
            </form>
          </div>

          <!-- Side info -->
          <div class="space-y-8">

            <!-- Testimonial -->
            <div class="bg-[#FFF0F1] rounded-3xl p-8 border border-[#DC3C52]/10">
              <blockquote class="text-xl font-semibold text-[#0D1B2A] leading-snug mb-6">
                "Huge win for me, my team, the hospital and the patients."
              </blockquote>
              <div class="flex items-center gap-3">
                <img
                  src="/img/testimonial-person.jpg"
                  alt="Hospital CNO"
                  class="w-12 h-12 rounded-full object-cover border-2 border-white shadow"
                  width="48" height="48"
                  loading="lazy"
                />
                <div>
                  <p class="font-bold text-[#0D1B2A] text-sm">CNO / Hospital</p>
                  <p class="text-gray-500 text-xs">interpretingWorks customer</p>
                </div>
              </div>
            </div>

            <!-- Platform screenshots side-by-side -->
            <div class="rounded-3xl overflow-hidden shadow-lg border border-gray-100">
              <div class="grid grid-cols-2 gap-0">
                <img
                  src="/img/bookings.png"
                  alt="interpretingWorks bookings dashboard"
                  class="w-full object-cover border-r border-gray-100"
                  width="400" height="300"
                  loading="lazy"
                />
                <img
                  src="/img/agencies-tablet.png"
                  alt="interpretingWorks agency management view"
                  class="w-full object-cover"
                  width="400" height="300"
                  loading="lazy"
                />
              </div>
              <div class="bg-white px-5 py-4 border-t border-gray-100">
                <p class="text-sm font-semibold text-[#0D1B2A]">See the platform in action</p>
                <p class="text-xs text-gray-400 mt-0.5">Request a demo and we'll walk you through it.</p>
              </div>
            </div>

            <!-- Quick info -->
            <div class="rounded-3xl bg-[#0D1B2A] text-white p-8">
              <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-5">Get in touch directly</p>
              <div class="space-y-4">
                <a href="tel:+18009050896" class="flex items-center gap-3 group">
                  <span class="w-9 h-9 rounded-xl bg-[#DC3C52]/20 flex items-center justify-center flex-shrink-0 group-hover:bg-[#DC3C52] transition-colors">
                    <svg class="w-4 h-4 text-[#DC3C52] group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25z"/></svg>
                  </span>
                  <span class="font-semibold text-sm">800-905-0896</span>
                </a>
                <a href="mailto:sales@interpreting.works" class="flex items-center gap-3 group">
                  <span class="w-9 h-9 rounded-xl bg-[#DC3C52]/20 flex items-center justify-center flex-shrink-0 group-hover:bg-[#DC3C52] transition-colors">
                    <svg class="w-4 h-4 text-[#DC3C52] group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>
                  </span>
                  <span class="font-semibold text-sm">sales@interpreting.works</span>
                </a>
                <a href="https://maps.google.com/?q=420+East+Main+St+Suite+7+Branford+CT+06405" target="_blank" rel="noopener noreferrer" class="flex items-start gap-3 group">
                  <span class="w-9 h-9 rounded-xl bg-[#DC3C52]/20 flex items-center justify-center flex-shrink-0 mt-0.5 group-hover:bg-[#DC3C52] transition-colors">
                    <svg class="w-4 h-4 text-[#DC3C52] group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/><path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0z"/></svg>
                  </span>
                  <span class="font-semibold text-sm leading-snug">420 East Main St. Suite 7<br />Branford, CT 06405</span>
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- TRUST BADGES -->
    <section class="py-14 bg-white border-y border-gray-100">
      <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-center text-xs font-bold uppercase tracking-[0.2em] text-gray-400 mb-8">Trusted, Certified &amp; Recognized</p>
        <ul class="flex flex-wrap justify-center items-center gap-10 md:gap-16 list-none p-0">
          {[
            { src: '/img/alc2024-badge.jpg',  alt: 'ALC 2024 Member Badge' },
            { src: '/img/aha-logo.png',       alt: 'AHA Associate' },
            { src: '/img/bbb-logo.webp',      alt: 'BBB Accredited Business' },
            { src: '/img/top100-badge.png',   alt: 'Top 100 Largest Language Service Providers' },
            { src: '/img/ata-logo.jpg',       alt: 'American Translators Association member' },
          ].map(badge => (
            <li>
              <img src={badge.src} alt={badge.alt} class="h-14 w-auto object-contain grayscale hover:grayscale-0 opacity-60 hover:opacity-100 transition-all duration-300" width="80" height="56" loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="bg-[#0D1B2A] text-white border-t border-white/10 pt-16 pb-8">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-14">
        <div class="lg:col-span-2">
          <img src="/img/logo.png" alt="interpretingWorks" class="h-10 w-auto mb-6 brightness-0 invert" width="200" height="64" loading="lazy" />
          <p class="text-gray-400 text-base max-w-sm leading-relaxed">
            interpretingWorks by Language Link Corporation. Professional interpreting scheduling for organizations and the LSPs that serve them across the United States.
          </p>
        </div>
        <nav aria-label="Company links">
          <h2 class="font-semibold text-sm uppercase tracking-wider text-gray-300 mb-5">Company</h2>
          <ul class="space-y-3 list-none p-0">
            <li><a href="/about/"   class="text-gray-400 hover:text-white transition-colors text-sm">About Us</a></li>
            <li><a href="/faq/"     class="text-gray-400 hover:text-white transition-colors text-sm">FAQ</a></li>
            <li><a href="/contact/" class="text-gray-400 hover:text-white transition-colors text-sm">Contact Us</a></li>
          </ul>
        </nav>
        <nav aria-label="Solutions links">
          <h2 class="font-semibold text-sm uppercase tracking-wider text-gray-300 mb-5">Solutions</h2>
          <ul class="space-y-3 list-none p-0">
            <li><a href="/services/organizations/"              class="text-gray-400 hover:text-white transition-colors text-sm">For Organizations</a></li>
            <li><a href="/services/language-service-providers/" class="text-gray-400 hover:text-white transition-colors text-sm">Access Point (for LSPs)</a></li>
            <li><a href="/services/mobile-app/"                 class="text-gray-400 hover:text-white transition-colors text-sm">Mobile App</a></li>
          </ul>
        </nav>
        <nav aria-label="Legal links">
          <h2 class="font-semibold text-sm uppercase tracking-wider text-gray-300 mb-5">Legal</h2>
          <ul class="space-y-3 list-none p-0">
            <li><a href="/privacy/" class="text-gray-400 hover:text-white transition-colors text-sm">Privacy Policy</a></li>
            <li><a href="/terms/"   class="text-gray-400 hover:text-white transition-colors text-sm">Terms of Service</a></li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
        <p>&copy; 2025 interpretingWorks · Language Link Corporation. All rights reserved.</p>
        <p>Serving hospitals, clinics, courts, schools, and businesses across the United States.</p>
      </div>
    </div>
  </footer>

</BaseLayout>
