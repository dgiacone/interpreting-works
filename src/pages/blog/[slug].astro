---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: 'interpretingWorks' },
  publisher: {
    '@type': 'Organization',
    name: 'interpretingWorks',
    logo: { '@type': 'ImageObject', url: 'https://interpreting.works/img/logo.png' },
  },
  ...(post.data.image ? { image: `https://interpreting.works${post.data.image}` } : {}),
};
---

<BaseLayout
  title={`${post.data.title} — interpretingWorks Blog`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  schema={[articleSchema]}
  geoRegion="US"
  geoPlacename="United States"
  breadcrumbs={[
    { name: 'Home',   href: 'https://interpreting.works/' },
    { name: 'Blog',   href: 'https://interpreting.works/blog/' },
    { name: post.data.title },
  ]}
>

  <main>

    <!-- HERO / META BAR -->
    <section class="bg-white border-b border-gray-100 pt-12 pb-10">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="mb-5 flex flex-wrap gap-2">
          {post.data.tags.map(tag => (
            <span class="rounded-full bg-[#FFF0F1] px-3 py-1 text-xs font-semibold text-[#DC3C52]">{tag}</span>
          ))}
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#0D1B2A] leading-tight mb-5">
          {post.data.title}
        </h1>

        <div class="flex items-center gap-4 text-sm text-gray-400">
          <span>{formatDate(post.data.pubDate)}</span>
          <span>&middot;</span>
          <span>{post.data.author}</span>
        </div>

      </div>
    </section>

    <!-- COVER IMAGE -->
    {post.data.image && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
        <div class="aspect-[16/9] overflow-hidden rounded-2xl bg-gray-100">
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full h-full object-cover"
            width="800"
            height="450"
          />
        </div>
      </div>
    )}

    <!-- ARTICLE BODY -->
    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="prose prose-lg max-w-none
        prose-headings:font-bold prose-headings:text-[#0D1B2A] prose-headings:tracking-tight
        prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
        prose-p:text-gray-600 prose-p:leading-relaxed
        prose-li:text-gray-600 prose-li:leading-relaxed
        prose-strong:text-[#0D1B2A] prose-strong:font-semibold
        prose-a:text-[#DC3C52] prose-a:font-medium hover:prose-a:text-[#b83044] prose-a:no-underline hover:prose-a:underline
        prose-blockquote:border-l-[#DC3C52] prose-blockquote:text-gray-500">
        <Content />
      </div>
    </article>

    <!-- NAV: BACK + CTA -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 border-t border-gray-100 pt-8">
      <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-[#DC3C52] hover:text-[#b83044] transition-colors">
        <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        Back to Blog
      </a>
      <a href="/contact/" class="inline-flex items-center gap-2 rounded-full bg-[#DC3C52] px-6 py-3 text-sm font-semibold text-white hover:bg-[#b83044] transition-colors">
        Talk to Our Team
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

  </main>

  <!-- FOOTER -->
  <footer class="bg-[#0D1B2A] text-white border-t border-white/10 pt-16 pb-8">
    <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-14">
        <div class="lg:col-span-2">
          <img src="/img/logo.png" alt="interpretingWorks" class="h-10 w-auto mb-6 brightness-0 invert" width="200" height="64" loading="lazy" />
          <p class="text-gray-400 text-base max-w-sm leading-relaxed">
            interpretingWorks by Language Link Corporation. Professional interpreting scheduling across the United States.
          </p>
        </div>
        <nav aria-label="Company links">
          <h2 class="font-semibold text-sm uppercase tracking-wider text-gray-300 mb-5">Company</h2>
          <ul class="space-y-3 list-none p-0">
            <li><a href="/about/"   class="text-gray-400 hover:text-white transition-colors text-sm">About Us</a></li>
            <li><a href="/blog/"    class="text-gray-400 hover:text-white transition-colors text-sm">Blog</a></li>
            <li><a href="/faq/"     class="text-gray-400 hover:text-white transition-colors text-sm">FAQ</a></li>
            <li><a href="/contact/" class="text-gray-400 hover:text-white transition-colors text-sm">Contact Us</a></li>
          </ul>
        </nav>
        <nav aria-label="Solutions links">
          <h2 class="font-semibold text-sm uppercase tracking-wider text-gray-300 mb-5">Solutions</h2>
          <ul class="space-y-3 list-none p-0">
            <li><a href="/services/organizations/" class="text-gray-400 hover:text-white transition-colors text-sm">For Organizations</a></li>
            <li><a href="/services/language-service-providers/" class="text-gray-400 hover:text-white transition-colors text-sm">Access Point</a></li>
          </ul>
        </nav>
        <nav aria-label="Legal links">
          <h2 class="font-semibold text-sm uppercase tracking-wider text-gray-300 mb-5">Legal</h2>
          <ul class="space-y-3 list-none p-0">
            <li><a href="/privacy/" class="text-gray-400 hover:text-white transition-colors text-sm">Privacy Policy</a></li>
            <li><a href="/terms/"   class="text-gray-400 hover:text-white transition-colors text-sm">Terms of Service</a></li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
        <p>&copy; 2025 interpretingWorks · Language Link Corporation. All rights reserved.</p>
        <p>Serving hospitals, clinics, courts, schools, and businesses across the United States.</p>
      </div>
    </div>
  </footer>

</BaseLayout>
